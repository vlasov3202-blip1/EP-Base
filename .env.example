# Development defaults only. Never place production secrets in this file.
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false

# PostgreSQL. Production requires verified TLS.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_TENANT_URL=
DATABASE_RLS_REQUIRED=false

# Enable both before controlled Silent Run after PostgreSQL identities are provisioned.
EINEIRO_DISTRIBUTED_RATE_LIMIT_REQUIRED=false
EINEIRO_RATE_LIMIT_HASH_KEY=
EINEIRO_AUDIT_INTEGRITY_REQUIRED=false
EINEIRO_AUDIT_INTEGRITY_KEY=
EINEIRO_REAUTH_TTL_MS=600000
REAUTH_RATE_LIMIT_PER_MINUTE=10

# Identity/Auth. External registration must not start without a real delivery service.
EINEIRO_AUTH_NOTIFIER_REQUIRED=false
EINEIRO_AUTH_NOTIFICATION_WEBHOOK_URL=
EINEIRO_AUTH_NOTIFICATION_WEBHOOK_TOKEN=

# Silent Run marketing contours. These flags are independent and server-enforced.
SILENT_RUN=true
PLATFORM_ACQUISITION_ENABLED=true
SELLER_CAMPAIGNS_ENABLED=false
SELLER_AD_CONNECTORS_ENABLED=false
PLATFORM_BUDGET_CAN_PROMOTE_OFFERS=false
SPONSORED_SHOWCASE_ENABLED=false
COMMERCIAL_PAYMENTS_ENABLED=false
EINEIRO_ROOT_OWNER_USER_ID=
YANDEX_DIRECT_CREDENTIAL_REF=
VK_ADS_CREDENTIAL_REF=

# Emergency AI controls.
VISION_KILL_SWITCH=false
MODERATION_KILL_SWITCH=false
MARKET_EVENT_RATE_LIMIT_PER_MINUTE=90
MARKET_EVENT_RATE_LIMIT_PER_DAY=2000
MARKET_EVENT_GLOBAL_RATE_LIMIT_PER_MINUTE=3000
